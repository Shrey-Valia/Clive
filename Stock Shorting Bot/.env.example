# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Alpaca PAPER keys (start with PK). The bot refuses to run with APCA_PAPER off.
APCA_API_KEY_ID=PK...
APCA_API_SECRET_KEY=...
APCA_PAPER=true

# Optional: Financial Modeling Prep key for headlines. Without it the bot uses Yahoo's RSS feed.
FMP_API_KEY=

# Supabase project (Settings -> API). The service-role key bypasses RLS: keep it on this machine only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
