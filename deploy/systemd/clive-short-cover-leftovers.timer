# Shorting leftover cover 10:00, 12:00, 14:00 ET (daily.py --cover-leftovers --execute)
[Unit]
Description=Clive timer: Shorting leftover cover 10:00, 12:00, 14:00 ET (daily.py --cover-leftovers --execute)

[Timer]
OnCalendar=Mon..Fri *-*-* 10,12,14:00:00 America/New_York
# A run missed while the VM was down must NOT replay late (a 09:31 entry at 11:00 is wrong).
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=clive-job@short-cover-leftovers.service

[Install]
WantedBy=timers.target
