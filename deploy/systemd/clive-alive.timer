# VM-alive heartbeat, hourly
[Unit]
Description=Clive timer: VM-alive heartbeat, hourly

[Timer]
OnCalendar=*-*-* *:05:00 UTC
# A run missed while the VM was down must NOT replay late (a 09:31 entry at 11:00 is wrong).
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=clive-alive.service

[Install]
WantedBy=timers.target
