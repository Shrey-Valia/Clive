# Options 12:45 ET half-day daily run (live/run.py --execute)
[Unit]
Description=Clive timer: Options 12:45 ET half-day daily run (live/run.py --execute)

[Timer]
OnCalendar=Mon..Fri *-*-* 12:45:00 America/New_York
# A run missed while the VM was down must NOT replay late (a 09:31 entry at 11:00 is wrong).
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=clive-job@opt-halfday.service

[Install]
WantedBy=timers.target
