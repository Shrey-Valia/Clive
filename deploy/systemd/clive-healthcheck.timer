# End-of-day run check, 16:30 ET trading days
[Unit]
Description=Clive timer: End-of-day run check, 16:30 ET trading days

[Timer]
OnCalendar=Mon..Fri *-*-* 16:30:00 America/New_York
# A run missed while the VM was down must NOT replay late (a 09:31 entry at 11:00 is wrong).
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=clive-healthcheck.service

[Install]
WantedBy=timers.target
