# Shorting 09:31 ET open entry (daily.py --open --execute)
[Unit]
Description=Clive timer: Shorting 09:31 ET open entry (daily.py --open --execute)

[Timer]
OnCalendar=Mon..Fri *-*-* 09:31:00 America/New_York
# A run missed while the VM was down must NOT replay late (a 09:31 entry at 11:00 is wrong).
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=clive-job@short-open.service

[Install]
WantedBy=timers.target
