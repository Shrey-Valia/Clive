# Options intraday exits (cron */15 10-14 and 0,15,30 15)
[Unit]
Description=Clive timer: Options intraday exits (cron */15 10-14 and 0,15,30 15)

[Timer]
OnCalendar=Mon..Fri *-*-* 10..14:00/15:00 America/New_York
OnCalendar=Mon..Fri *-*-* 15:00,15,30:00 America/New_York
# A run missed while the VM was down must NOT replay late (a 09:31 entry at 11:00 is wrong).
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=clive-job@opt-intraday.service

[Install]
WantedBy=timers.target
