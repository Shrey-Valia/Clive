# Shorting 16:15 ET Supabase sync (sync.py)
[Unit]
Description=Clive timer: Shorting 16:15 ET Supabase sync (sync.py)

[Timer]
OnCalendar=Mon..Fri *-*-* 16:15:00 America/New_York
# A run missed while the VM was down must NOT replay late (a 09:31 entry at 11:00 is wrong).
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=clive-job@short-sync.service

[Install]
WantedBy=timers.target
