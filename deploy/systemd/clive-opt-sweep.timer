# Options 09:45 ET expiry-day sweep, mandatory (live/run.py --sweep --execute)
[Unit]
Description=Clive timer: Options 09:45 ET expiry-day sweep, mandatory (live/run.py --sweep --execute)

[Timer]
OnCalendar=Mon..Fri *-*-* 09:45:00 America/New_York
# A run missed while the VM was down must NOT replay late (a 09:31 entry at 11:00 is wrong).
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=clive-job@opt-sweep.service

[Install]
WantedBy=timers.target
