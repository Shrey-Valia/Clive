# health/check.py read-only probe: every 15 min 09:00-16:45 ET plus 07:15 and 17:00, Mon-Fri
[Unit]
Description=Clive timer: health/check.py probe (every 15 min 09:00-16:45 ET, 07:15, 17:00, Mon-Fri)

[Timer]
OnCalendar=Mon..Fri *-*-* 09..16:00/15:00 America/New_York
OnCalendar=Mon..Fri *-*-* 07:15:00 America/New_York
OnCalendar=Mon..Fri *-*-* 17:00:00 America/New_York
# A run missed while the VM was down must NOT replay late (a 09:31 entry at 11:00 is wrong).
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=clive-job@health-check.service

[Install]
WantedBy=timers.target
