# Shorting 15:40 ET close job: 15:45 scan, 15:55 cover-all (daily.py --execute)
[Unit]
Description=Clive timer: Shorting 15:40 ET close job: 15:45 scan, 15:55 cover-all (daily.py --execute)

[Timer]
OnCalendar=Mon..Fri *-*-* 15:40:00 America/New_York
# A run missed while the VM was down must NOT replay late (a 09:31 entry at 11:00 is wrong).
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=clive-job@short-close.service

[Install]
WantedBy=timers.target
