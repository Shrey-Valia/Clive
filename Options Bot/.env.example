# Options Bot live paper trading (live/run.py). Copy to "Options Bot/.env" (gitignored); never commit real keys.
#
# Use a SEPARATE Alpaca paper account for options. Do NOT reuse the Stock
# Shorting Bot keys: that account belongs to the live shorting bot. The options
# bot never reads APCA_* for trading and refuses to trade without these.
OPT_APCA_API_KEY_ID=PK...
OPT_APCA_API_SECRET_KEY=...
# Must be true. The bot refuses to run otherwise, and refuses any non-paper base URL.
OPT_APCA_PAPER=true
# Optional; only the paper endpoint is accepted.
# OPT_APCA_BASE_URL=https://paper-api.alpaca.markets

# Optional: live stock price feed for the 15:50 snapshot. "iex" works on the free plan; "sip" needs Algo Trader Plus.
# OPT_STOCK_FEED=iex

# Supabase (same project as the dashboard). Leave empty to skip all database writes.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Shorting bot account id or number (Alpaca dashboard). The options bot refuses to trade if its
# keys resolve to this account, so it can never touch the shorting bot positions.
SHORTING_ACCOUNT_NUMBER=
